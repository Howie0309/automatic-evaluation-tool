# 复制为 .env 并填入火山方舟 API Key，即可启用实时生成。
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-1-pro-260915
PORT=8787
# 仅本机使用时可以留空。
ACCESS_CODE=

# 如使用 OneAPI，可在页面“API 设置”填写，或取消下方注释。
# ONEAPI_BASE=https://你的网关/v1
# ONEAPI_MODEL=网关中可用的模型名称
# ONEAPI_API_KEY=你的OneAPI令牌

# 可选：设置后默认使用 Tavily 搜索；也可以在页面搜索设置中填写。
# TAVILY_API_KEY=你的Tavily密钥
